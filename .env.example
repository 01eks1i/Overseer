# Solana RPC. The public devnet endpoint is rate-limited; a free Helius devnet URL is more reliable.
RPC_URL=https://api.devnet.solana.com

# Paid API server
API_PORT=4020
API_BASE_URL=http://localhost:4020

# Needed for the /api/analyze service (Task B). Put real values in .env, never in this file (it's committed).
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace (the API then asks for an anthropic-workspace-id header)
ANTHROPIC_WORKSPACE_ID=
